        {
            "label": "esp: config",
            "type": "shell",
            "command": ". 'C:/Users/Richa/.espressif/activate-idf.ps1'; idf.py menuconfig",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "group": "idf"
            },
            "problemMatcher": [],
            "icon": {
                "id": "symbol-property",
            },
        },
        {
            "label": "esp: clean",
            "type": "shell",
            "command": ". 'C:/Users/Richa/.espressif/activate-idf.ps1'; idf.py fullclean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "group": "idf"
            },
            "problemMatcher": [],
            "icon": {
                "id": "clear-all",
            },
        },
        {
            "label": "esp: debug",
            "type": "shell",
            "command": "'C:/Users/Richa/.espressif/tools/openocd-esp32/v0.12.0-esp32-20260424/openocd-esp32/bin/openocd.exe' -s 'C:/Users/Richa/.espressif/tools/openocd-esp32/v0.12.0-esp32-20260424/openocd-esp32/share/openocd/scripts' -f interface/esp_usb_jtag.cfg -f target/esp32s3.cfg",
            "dependsOn": "idf: build",
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": {
                "owner": "openocd",
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "endLine": 2,
                    "endColumn": 3,
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Open On-Chip Debugger",
                    "endsPattern": "Info : Listening on port 3333 for gdb connections"
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "hide": true,
        }
    ]
}
