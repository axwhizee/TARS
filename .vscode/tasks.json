{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "esp: build",
            "type": "shell",
            "command": ". 'C:/Users/Richa/.espressif/activate-idf.ps1'; idf.py build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "group": "idf"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {   // 该字段需要安装`Tasks`扩展才生效
                "id": "play",
            },
        },
        {
            "label": "esp: flash",
            "type": "shell",
            "command": ". 'C:/Users/Richa/.espressif/activate-idf.ps1'; idf.py flash",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "group": "idf"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "icon": {
                "id": "symbol-event",
            },
        },
