# 0. 目标芯片: ESP32-S3 (N16R8)
CONFIG_IDF_TARGET="esp32s3"

# 1. 设置 Flash 大小为 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 2. 启用 PSRAM
CONFIG_SPIRAM=y

# 3. 配置 R8 的 Octal PSRAM (8MB)
# N16R8 使用的是 Octal SPI PSRAM，必须开启此选项
CONFIG_SPIRAM_MODE_OCT=y

# 4. 设置 PSRAM 速度 (Octal 通常支持 80MHz 或 120MHz，建议先设 80MHz 稳定)
CONFIG_SPIRAM_SPEED_80M=y

# 5. 禁用证书包 (解决你之前的 x509_crt_bundle 报错)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# 6. Update flash image header to 16MB
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# 7. 禁止 Tickless Idle (否则vTaskDelay永不返回)
# v6.0 中该选项 depends on PM_ENABLE (未启用 PM 时不可见, 默认即关闭, 此项无需设置)

# 8. 任务栈保留在内部RAM (避免PSRAM缓存错误)
# v6.0 中 CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY 已改名:
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n

# 9. 启用 HTTPD WebSocket 支持
CONFIG_HTTPD_WS_SUPPORT=y

# 10. WiFi/lwIP 堆分配移至 PSRAM — 释放内部RAM供TCP连接使用
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 11. 扩大 socket 上限 (httpd max_open_sockets + 4设备 + 3内部预留)
CONFIG_LWIP_MAX_SOCKETS=22

# 12. 缩减每连接TCP缓冲 (2*MSS=2920, 原5760太大占用内部RAM)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2920
CONFIG_LWIP_TCP_WND_DEFAULT=2920

# 13. 缩短TCP MSL (60s→10s 减少僵尸连接占用)
CONFIG_LWIP_TCP_MSL=10000

# 14. 关闭IP分片重组 (纯 HTTP/WS 不会有大包)
CONFIG_LWIP_IP4_REASSEMBLY=n
CONFIG_LWIP_IP6_REASSEMBLY=n

# 15. 扩大TCP接收/接受邮箱 (多设备WiFi抖动下缓冲TCP段)
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=12

# 16. lwIP 协议栈固定在 Core 0 (与 WiFi 驱动同核, 避免跨核缓存同步)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# 17. 启用 FreeRTOS 运行时统计 (vTaskGetRunTimeStats)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# 18. 自定义分区表 (default_16MB.csv: nvs + OTA + spiffs)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="default_16MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="default_16MB.csv"
